PORT=3001
TIMEZONE=Asia/Baku
TEACHER_WHATSAPP=994XXXXXXXXX
PAYMENT_CYCLE_LESSONS=8
PAYMENT_REMINDER_DAYS=3,7
DEFAULT_REMINDER_MINUTES=60

# ── WhatsApp Cloud API (official bot) ────────────────────────────────
# Webhook secrets stay here, never in the database.
# WA_APP_SECRET: Meta App → Settings → Basic → App Secret. Used to verify the
#   signature on every webhook; without it the webhook refuses all traffic.
WA_APP_SECRET=
# WA_VERIFY_TOKEN: any random string you invent. Paste the same value into
#   Meta App → WhatsApp → Configuration → Verify token.
WA_VERIFY_TOKEN=
# The rest can also be set from the CRM (Settings → WhatsApp Cloud):
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
# Numbers that get the coach's control menu, comma separated, 994… format.
WA_ADMIN_NUMBERS=994703900007
